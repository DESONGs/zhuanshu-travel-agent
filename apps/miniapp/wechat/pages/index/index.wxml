<view class="page">
  <view class="header"><text class="brand">Travel Agent</text><text class="locale">中 / EN</text></view>
  <view class="intro" wx:if="{{!signedIn}}"><text class="title">从一句话开始规划旅行。</text><text class="copy">旅行助手会持续理解你的补充，再把吃、住、行、玩放到同一份方案里。</text></view>
  <view class="card" wx:if="{{!signedIn}}"><text class="card-title">使用微信登录</text><text class="copy">登录后直接进入旅行对话。没有完成真实授权时不会创建模拟账户。</text><button class="primary" loading="{{loading}}" bindtap="signIn">登录并开始对话</button></view>
  <block wx:else>
    <view class="chat-head"><text class="card-title">说说你想怎么旅行</text><text class="copy">目的地、时间、同行人不必一次说完整。</text></view>
    <scroll-view class="messages" scroll-y="true" scroll-into-view="message-end">
      <view wx:if="{{!conversation.messages.length}}" class="empty">例如：国庆和父母去大理 5 天，轻松一点，住宿位置请你帮我设计。</view>
      <view wx:for="{{conversation.messages}}" wx:key="messageId" class="message {{item.role}}"><text>{{item.text}}</text></view>
      <view id="message-end"></view>
    </scroll-view>
    <view class="composer"><textarea value="{{input}}" bindinput="onInput" maxlength="4000" auto-height="true" placeholder="输入旅行想法或继续补充"></textarea><view class="composer-actions"><picker wx:if="{{modelOptions.length}}" mode="selector" range="{{modelOptions}}" range-key="shortLabel" value="{{modelIndex}}" disabled="{{loading}}" bindchange="onModelChange"><view class="model-picker">思考模型 · {{modelOptions[modelIndex].shortLabel}}</view></picker><button class="send" loading="{{loading}}" disabled="{{!input || loading}}" bindtap="sendMessage">发送</button></view></view>
    <view class="trip-summary" wx:if="{{trip}}"><text class="card-title">{{trip.destination}}</text><text class="copy">{{trip.timeLabel}} · {{trip.travelerCount}} 位同行人</text><view class="trip-facts" wx:if="{{trip.budgetLabel || trip.paceLabel}}"><text wx:if="{{trip.budgetLabel}}">{{trip.budgetLabel}}</text><text wx:if="{{trip.paceLabel}}">{{trip.paceLabel}}</text></view><view class="traveler-care" wx:if="{{trip.travelerCare.length}}"><text class="section-label">同行人的安排重点</text><view wx:for="{{trip.travelerCare}}" wx:key="travelerId"><text>{{item.displayName}}</text><text>{{item.labelText}}</text></view></view></view>
    <map wx:if="{{markers.length}}" class="map" markers="{{markers}}" longitude="{{markers[0].longitude}}" latitude="{{markers[0].latitude}}" scale="11"></map>
    <view class="plan" wx:if="{{proposal}}">
      <text class="card-title">比较旅行候选</text>
      <text class="copy">每一类先选一个，确认后才会加入旅行。</text>
      <view wx:for="{{proposalDomains}}" wx:key="key" class="domain"><text class="domain-title">{{item.label}}</text><view wx:for="{{item.candidates}}" wx:for-item="candidate" wx:key="nodeId" class="candidate {{candidate.selected ? 'selected' : ''}}" data-domain="{{item.key}}" data-node-id="{{candidate.nodeId}}" bindtap="selectCandidate"><image wx:if="{{candidate.photo}}" src="{{candidate.photo}}" mode="aspectFill"></image><view><text>{{candidate.title}}</text><text class="candidate-copy">{{candidate.summary}}</text></view></view></view>
      <button class="primary" loading="{{loading}}" bindtap="acceptProposal">确认所选方案</button>
    </view>
    <view class="plan" wx:if="{{accepted.length}}"><text class="card-title">已确认方案</text><view wx:for="{{accepted}}" wx:key="nodeId" class="accepted"><text>{{item.title}}</text><text class="candidate-copy">{{item.summary}}</text></view></view>
    <view class="plan mobility" wx:if="{{mobility}}"><text class="card-title">地点之间怎么走</text><text class="copy">{{mobility.notice}}</text><view wx:for="{{mobility.legs}}" wx:key="legId" class="mobility-leg"><text class="route-title">{{item.origin.label}} → {{item.destination.label}}</text><view class="route-facts"><text>{{item.modeLabel}}</text><text>约 {{item.minutes}} 分钟</text><text wx:if="{{item.walkingMeters != null}}">步行 {{item.walkingMeters}} 米</text><text wx:if="{{item.transfers != null}}">{{item.transfers}} 次换乘</text></view><view class="route-facilities" wx:if="{{item.facilities.length}}"><text wx:for="{{item.facilities}}" wx:for-item="facility" wx:key="kind" class="{{facility.kind === 'stairs' ? 'barrier' : 'assist'}}">{{facility.note}}</text></view><text class="candidate-copy">{{item.rationale}}</text></view></view>
  </block>
  <text class="notice bottom" wx:if="{{notice}}">{{notice}}</text>
</view>
