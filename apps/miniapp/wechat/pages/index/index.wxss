.page { min-height:100vh; padding-bottom:64rpx; color:#17191c; background:#f6f8f9; }
.header { display:flex; justify-content:space-between; padding:38rpx 30rpx 24rpx; background:#fff; border-bottom:1rpx solid #e3e7ea; }
.brand { font-size:34rpx; font-weight:700; }.locale,.copy,.notice { color:#59656f; font-size:25rpx; line-height:1.65; }
.intro,.chat-head { padding:44rpx 30rpx 28rpx; }.title { display:block; font-size:52rpx; line-height:1.2; font-weight:700; }.copy { display:block; margin-top:12rpx; }
.card,.plan,.trip-summary { margin:0 24rpx 24rpx; padding:28rpx; background:#fff; border:1rpx solid #e1e6e9; border-radius:24rpx; }.card-title { display:block; font-size:32rpx; font-weight:700; }
.primary { margin-top:24rpx; color:#fff; background:#ff5a4f; border-radius:18rpx; }.messages { height:46vh; padding:0 24rpx; box-sizing:border-box; }.message { max-width:86%; margin:14rpx 0; padding:20rpx 22rpx; border-radius:8rpx 22rpx 22rpx; color:#17191c; background:#fff; font-size:28rpx; line-height:1.6; }.message.user { margin-left:auto; color:#fff; background:#263b4d; border-radius:22rpx 8rpx 22rpx 22rpx; }.message.status { color:#75440f; background:#fff7ed; }
.composer { position:sticky; bottom:0; z-index:2; display:grid; gap:14rpx; padding:20rpx 24rpx 24rpx; background:#fff; border-top:1rpx solid #e3e7ea; }.composer textarea { min-height:84rpx; max-height:220rpx; padding:16rpx 18rpx; border:1rpx solid #cbd2d7; border-radius:18rpx; background:#fff; font-size:27rpx; }.composer-actions { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.model-picker { min-height:64rpx; display:flex; align-items:center; padding:0 20rpx; color:#40515e; background:#f4f7f8; border:1rpx solid #d6dde1; border-radius:16rpx; font-size:23rpx; font-weight:700; }.send { width:132rpx; height:68rpx; line-height:68rpx; margin:0; color:#fff; background:#ff5a4f; border-radius:16rpx; font-size:26rpx; }
.trip-summary { margin-top:24rpx; }.map { width:calc(100% - 48rpx); height:420rpx; margin:0 24rpx 24rpx; border-radius:24rpx; overflow:hidden; }
.domain { margin-top:24rpx; }.domain-title { display:block; margin-bottom:12rpx; font-size:28rpx; font-weight:700; }.candidate { display:flex; gap:16rpx; margin-top:12rpx; padding:16rpx; border:1rpx solid #dfe5e8; border-radius:18rpx; background:#fff; }.candidate.selected { border-color:#4b956b; background:#f1f9f3; }.candidate image { width:128rpx; height:108rpx; flex:none; border-radius:14rpx; }.candidate view { min-width:0; display:grid; gap:6rpx; }.candidate text:first-child,.accepted text:first-child { font-size:27rpx; font-weight:700; }.candidate-copy { display:block; margin-top:6rpx; color:#59656f; font-size:23rpx; line-height:1.5; }.accepted { padding:20rpx 0; border-bottom:1rpx solid #e5e8eb; }.empty { padding:34rpx 24rpx; color:#59656f; font-size:26rpx; line-height:1.6; }.notice { display:block; }.bottom { margin:18rpx 30rpx 0; }
.trip-facts,.route-facts,.route-facilities { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:16rpx; }
.trip-facts text,.route-facts text,.route-facilities text { padding:8rpx 12rpx; border-radius:12rpx; color:#4d5c66; background:#eef3f5; font-size:21rpx; }
.traveler-care { margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid #ece4e1; }
.section-label { display:block; color:#7d5149; font-size:23rpx; font-weight:700; }
.traveler-care view { display:grid; gap:5rpx; margin-top:12rpx; }
.traveler-care view text:first-child { font-size:24rpx; font-weight:700; }
.traveler-care view text:last-child { color:#655e5b; font-size:22rpx; line-height:1.5; }
.mobility-leg { margin-top:20rpx; padding:20rpx; border:1rpx solid #dbe6eb; border-radius:18rpx; background:#f8fbfd; }
.route-title { display:block; font-size:25rpx; font-weight:700; }
.route-facilities text.assist { color:#255f47; background:#e8f5ec; }
.route-facilities text.barrier { color:#8b5018; background:#fff1df; }
.workspace-tabs { position:sticky; top:0; z-index:4; display:grid; grid-template-columns:repeat(3,1fr); gap:8rpx; padding:12rpx 24rpx; background:rgba(246,248,249,.96); }
.workspace-tabs button { height:72rpx; line-height:72rpx; margin:0; padding:0; border:0; border-radius:18rpx; color:#60717b; background:#e9eef1; font-size:25rpx; font-weight:700; }
.workspace-tabs button::after,.decision-tabs button::after,.map-cta::after { border:0; }
.workspace-tabs button.active { color:#245b73; background:#fff; box-shadow:0 6rpx 18rpx rgba(50,73,86,.09); }
.messages { height:calc(100vh - 430rpx); }
.composer-hint { color:#74818a; font-size:22rpx; }
.decision-tabs { display:grid; grid-template-columns:repeat(4,1fr); gap:8rpx; margin-top:24rpx; }
.decision-tabs button { min-width:0; height:92rpx; margin:0; padding:10rpx 6rpx; border:1rpx solid #dfe5e8; border-radius:16rpx; color:#617079; background:#f5f8f9; font-size:25rpx; font-weight:700; line-height:1.25; }
.decision-tabs button.active { color:#255f47; border-color:#a8cfb5; background:#edf8f0; }
.decision-tabs text { display:block; margin-top:4rpx; font-size:18rpx; font-weight:500; }
.facility-copy { display:block; margin-top:8rpx; color:#316449; font-size:20rpx; line-height:1.45; }
.schedule-label { display:block; margin-bottom:6rpx; color:#6a7b85; font-size:20rpx; font-weight:700; }
.map-cta { margin-top:22rpx; color:#315f77; border:1rpx solid #b9ced9; border-radius:18rpx; background:#eef7fb; font-size:24rpx; font-weight:700; }
.facility-panel { margin-top:0; }
