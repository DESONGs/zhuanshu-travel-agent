<view class="page">
  <view class="header"><text class="brand">Travel Agent</text><text class="locale">中 / EN</text></view>
  <view class="intro" a:if="{{!signedIn}}"><text class="title">从一句话开始规划旅行。</text><text class="copy">旅行助手会持续理解你的补充，再把吃、住、行、玩放到同一份方案里。</text></view>
  <view class="card" a:if="{{!signedIn}}"><text class="card-title">使用支付宝登录</text><text class="copy">登录后直接进入旅行对话。没有完成真实授权时不会创建模拟账户。</text><button class="primary" loading="{{loading}}" onTap="signIn">登录并开始对话</button></view>
  <block a:else>
    <block a:if="{{activeView === 'conversation'}}">
      <view class="chat-head"><text class="card-title">说说你想怎么旅行</text><text class="copy">目的地、时间、同行人不必一次说完整。</text></view>
      <scroll-view class="messages" scroll-y="true"><view a:if="{{!conversation.messages.length}}" class="empty">例如：国庆和父母去大理 5 天，轻松一点，住宿位置请你帮我设计。</view><view a:for="{{conversation.messages}}" a:key="messageId" class="message {{item.role}}"><text>{{item.text}}</text></view></scroll-view>
      <view class="composer"><textarea value="{{input}}" onInput="onInput" maxlength="4000" auto-height="true" placeholder="输入旅行想法或继续补充"></textarea><view class="composer-actions"><text class="composer-hint">先理解，再生成方案</text><button class="send" loading="{{loading}}" disabled="{{!input || loading}}" onTap="sendMessage">发送</button></view></view>
    </block>
    <block a:if="{{activeView === 'itinerary'}}">
      <view class="trip-summary" a:if="{{trip}}"><text class="card-title">{{trip.destination}}</text><text class="copy">{{trip.timeLabel}} · {{trip.travelerCount}} 位同行人</text><view class="trip-facts" a:if="{{trip.budgetLabel || trip.paceLabel}}"><text a:if="{{trip.budgetLabel}}">{{trip.budgetLabel}}</text><text a:if="{{trip.paceLabel}}">{{trip.paceLabel}}</text></view><view class="traveler-care" a:if="{{trip.travelerCare.length}}"><text class="section-label">同行人的安排重点</text><view a:for="{{trip.travelerCare}}" a:key="travelerId"><text>{{item.displayName}}</text><text>{{item.labelText}}</text></view></view></view>
      <view class="plan budget-board" a:if="{{planBudget}}"><text class="card-title">{{planBudget.summary}}</text><text class="copy">分域合计为确定性估算；候选单价仍保留实价、参考价或待核验。</text><view class="budget-rows"><view a:for="{{planBudget.rows}}" a:key="domain"><text>{{item.label}}</text><text>{{item.amountLabel}}</text><text>{{item.basis}}</text></view></view></view>
      <view class="plan" a:if="{{proposal}}"><text class="card-title">比较旅行候选</text><text class="copy">从抵达开始逐项决定；只确认你已选择的环节，其他候选继续保留。</text><view class="decision-tabs"><button a:for="{{proposalDomains}}" a:key="key" data-domain="{{item.key}}" class="{{activeDomainKey === item.key ? 'active' : ''}}" onTap="switchDecisionDomain">{{item.label}}<text>{{item.hasSelection ? '已选' : item.candidates.length + ' 个'}}</text></button></view><view a:for="{{proposalDomains}}" a:key="key" a:if="{{item.key === activeDomainKey}}" class="domain"><view a:for="{{item.candidates}}" a:for-item="candidate" a:key="nodeId" class="candidate {{candidate.selected ? 'selected' : ''}}" data-domain="{{item.key}}" data-node-id="{{candidate.nodeId}}" onTap="selectCandidate"><image a:if="{{candidate.photo}}" src="{{candidate.photo}}" mode="aspectFill"></image><view><text>{{candidate.title}}</text><view class="candidate-price {{candidate.priceTone}}"><text>{{candidate.priceLabel}}</text><text>{{candidate.priceDetail}}</text></view><text class="candidate-copy">{{candidate.summary}}</text><text class="facility-copy" a:if="{{candidate.facilityText}}">{{candidate.facilityText}}</text></view></view></view><button class="primary" loading="{{loading}}" onTap="acceptProposal">确认当前已选</button></view>
      <view class="plan" a:if="{{accepted.length}}"><text class="card-title">已确认安排</text><text class="copy">没有可靠时间时不会自动编造时间表。</text><view a:for="{{accepted}}" a:key="nodeId" class="accepted"><text class="schedule-label">{{item.scheduleLabel}}</text><text>{{item.title}}</text><text class="candidate-copy">{{item.summary}}</text><view class="route-facilities" a:if="{{item.facilities.length}}"><text a:for="{{item.facilities}}" a:for-item="facility" a:key="kind">{{facility.note}}</text></view></view><button class="map-cta" data-view="map" onTap="switchView">查看地图、路线和设施</button></view>
    </block>
    <block a:if="{{activeView === 'map'}}">
      <map a:if="{{markers.length}}" class="map" markers="{{markers}}" longitude="{{markers[0].longitude}}" latitude="{{markers[0].latitude}}" scale="11"></map>
      <view class="plan facility-panel" a:if="{{accepted.length}}"><text class="card-title">地点设施参考</text><text class="copy">地图有记录 · 非实时 · 建议现场确认。</text><view a:for="{{accepted}}" a:key="nodeId" class="accepted"><text>{{item.title}}</text><view class="route-facilities" a:if="{{item.facilities.length}}"><text a:for="{{item.facilities}}" a:for-item="facility" a:key="kind">{{facility.note}}</text></view><text class="candidate-copy" a:else>没有返回设施资料，不代表现场没有。</text></view></view>
      <view class="plan mobility" a:if="{{mobility}}"><text class="card-title">地点之间怎么走</text><text class="copy">{{mobility.notice}}</text><view a:for="{{mobility.legs}}" a:key="legId" class="mobility-leg"><text class="route-title">{{item.origin.label}} → {{item.destination.label}}</text><view class="route-facts"><text>{{item.modeLabel}}</text><text>约 {{item.minutes}} 分钟</text><text a:if="{{item.walkingMeters != null}}">步行 {{item.walkingMeters}} 米</text><text a:if="{{item.transfers != null}}">{{item.transfers}} 次换乘</text></view><view class="route-facilities" a:if="{{item.facilities.length}}"><text a:for="{{item.facilities}}" a:for-item="facility" a:key="kind" class="{{facility.kind === 'stairs' ? 'barrier' : 'assist'}}">{{facility.note}}</text></view><text class="candidate-copy">{{item.rationale}}</text></view></view>
    </block>
    <view class="workspace-tabs bottom-tabs"><button data-view="conversation" class="{{activeView === 'conversation' ? 'active' : ''}}" onTap="switchView">对话</button><button data-view="itinerary" class="{{activeView === 'itinerary' ? 'active' : ''}}" disabled="{{!trip}}" onTap="switchView">行程<text class="tab-badge" a:if="{{proposalDomains.length}}">{{proposalDomains.length}}</text></button><button data-view="map" class="{{activeView === 'map' ? 'active' : ''}}" disabled="{{!trip}}" onTap="switchView">地图</button></view>
  </block>
  <text class="notice bottom" a:if="{{notice}}">{{notice}}</text>
</view>
