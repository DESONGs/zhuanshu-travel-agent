{
  "name": "travel-agent-v1",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "travel-agent-pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "library:build": "npm run build --workspace zhuanshu-travel-agent",
    "library:typecheck": "npm run typecheck --workspace zhuanshu-travel-agent",
    "pretest": "npm run library:build",
    "test": "node --test travel-agent-pi-package/tests/*.test.mjs tests/*.test.mjs",
    "typecheck": "npm run library:typecheck",
    "check": "npm run typecheck && npm test && npm run web:build && npm run miniapp:check",
    "package:publint": "npm run library:build && npm_config_cache=.npm-cache publint travel-agent-pi-package",
    "package:pack:dry-run": "npm_config_cache=.npm-cache npm pack --workspace zhuanshu-travel-agent --dry-run",
    "package:consumer-smoke": "node scripts/verify-npm-package.mjs",
    "release:check": "npm run check && npm run package:publint && npm run package:pack:dry-run && npm run package:consumer-smoke",
    "mcp": "node src/mcp/server.mjs",
    "api": "node src/http/server.mjs",
    "smoke:models": "node scripts/smoke-model-providers.mjs",
    "smoke:conversation": "node scripts/smoke-conversation-golden-path.mjs",
    "smoke:amap": "node scripts/smoke-amap-provider.mjs",
    "diagnose:amap": "node scripts/diagnose-amap-web-service.mjs",
    "smoke:weather": "node scripts/smoke-weather-provider.mjs",
    "smoke:inventory": "node scripts/smoke-inventory-providers.mjs",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "vite build",
    "web:preview": "vite preview --host 127.0.0.1",
    "db:migrate": "node src/persistence/migrate.mjs",
    "miniapp:weapp": "node scripts/check-miniapps.mjs wechat",
    "miniapp:alipay": "node scripts/check-miniapps.mjs alipay",
    "miniapp:check": "node scripts/check-miniapps.mjs",
    "native:sync": "npm run web:build && cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.1",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@quintinshaw/pi-dynamic-workflows": "3.5.1",
    "@types/node": "24.12.4",
    "@vitejs/plugin-react": "5.0.2",
    "pi-subagents": "0.46.0",
    "publint": "0.3.23",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@capacitor/android": "7.4.1",
    "@capacitor/core": "7.4.1",
    "@capacitor/ios": "7.4.1",
    "@fly-ai/flyai-cli": "1.0.16",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@phosphor-icons/react": "2.1.10",
    "express": "5.1.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.4.3"
  }
}
