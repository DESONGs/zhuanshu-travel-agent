{
  "schemaVersion": "travel-model-routing-v1",
  "defaultRoute": "deliberation",
  "routes": {
    "deliberation": {
      "purpose": "Intent resolution, trade-off explanation, and parent-agent decisions.",
      "providerRole": "reasoning",
      "preferredProvider": "deepseek",
      "preferredModel": "deepseek-v4-flash",
      "thinkingLevel": "high",
      "toolCalling": "sequential_bounded",
      "requiresHumanReviewFor": ["booking_handoff", "locked_change", "payment_or_identity_data"]
    },
    "extraction": {
      "purpose": "Turn untrusted social content into attributed candidate claims.",
      "providerRole": "subagent",
      "preferredProvider": "moonshotai-cn",
      "preferredModel": "kimi-k2.6",
      "thinkingLevel": "low",
      "mustReturn": ["claim_confidence", "evidence_pointer", "uncertainty"]
    },
    "verification": {
      "purpose": "Verify time-sensitive facts with official or authorized providers.",
      "providerRole": "official_provider_first",
      "modelFallback": "deepseek",
      "mustReturn": ["checked_at", "source", "freshness"]
    },
    "multimodal": {
      "purpose": "Understand a user-authorized image and message together, then reason and call bounded travel tools in the same Parent Agent turn.",
      "providerRole": "vision",
      "preferredProvider": "deepseek",
      "preferredModel": "deepseek-v4-flash-vision-exp",
      "fallbackProvider": "moonshotai-cn",
      "fallbackModel": "kimi-k2.6",
      "input": ["text", "image"],
      "thinkingLevel": "high",
      "agentMode": "native_multimodal_tools",
      "mustReturn": ["claim_confidence", "evidence_pointer", "uncertainty"],
      "forbidden": ["raw_social_media_download", "identity_document_analysis", "payment_or_passport_input"]
    }
  }
}
