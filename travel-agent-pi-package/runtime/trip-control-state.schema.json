{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip-control-state-v1",
  "type": "object",
  "required": ["schemaVersion", "tripId", "revision", "travelers", "nodes", "edges", "taskQueues", "budgetLedger", "fulfillmentLedger", "evidence"],
  "properties": {
    "schemaVersion": { "const": "trip-control-state-v1" },
    "tripId": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "travelers": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["travelerId", "displayName", "language", "hardConstraints", "softPreferences", "careNeeds", "operability"],
        "properties": {
          "travelerId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
          "relationship": { "type": ["string", "null"], "maxLength": 40 },
          "language": { "type": "string" },
          "hardConstraints": { "type": "array" },
          "softPreferences": { "type": "array" },
          "careNeeds": {
            "type": "object",
            "properties": {
              "mobility": { "type": "object" },
              "stamina": { "type": "object" },
              "schedule": { "type": "object" },
              "facilities": { "type": "object" },
              "sensory": { "type": "object" },
              "food": { "type": "object" }
            },
            "additionalProperties": false
          },
          "operability": { "type": "object" }
        }
      }
    },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "taskQueues": { "type": "object" },
    "budgetLedger": { "type": "object" },
    "environment": { "type": "object" },
    "fulfillmentLedger": { "type": "array" },
    "evidence": { "type": "object" }
  }
}
