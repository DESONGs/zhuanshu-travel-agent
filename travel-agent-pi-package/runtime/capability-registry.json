{
  "schemaVersion": "travel-capability-registry-v2",
  "defaults": {
    "alwaysOn": ["trip_control", "travel_context", "trip_patch", "policy", "travel_qa", "observability"],
    "loadPolicy": "Load only capabilities relevant to the current decision. Provider availability is derived at runtime."
  },
  "capabilities": [
    {
      "capabilityId": "trip_control",
      "description": "Shared trip state, decision graph, dirty-set calculation, and work queues.",
      "securityRequirements": ["parent_owned_state", "revision_checked_mutations"]
    },
    {
      "capabilityId": "travel_context",
      "description": "Decision-scoped context plus deterministic weather and mobility freshness gates.",
      "securityRequirements": ["bounded_context", "no_sensitive_fields"]
    },
    {
      "capabilityId": "trip_patch",
      "description": "Revision-aware proposal validation and parent-authorized commit.",
      "securityRequirements": ["write_contract", "lock_check", "explicit_confirmation_for_commit"]
    },
    {
      "capabilityId": "social_read_worker",
      "description": "Read-only social discovery through an isolated worker.",
      "toolPackage": "third-party-or-mcp",
      "securityRequirements": ["fixed_sha", "license_review", "no_credentials_in_parent", "isolated_read_only_smoke_required"]
    },
    {
      "capabilityId": "china_travel_content_research",
      "description": "China travel research across discovery, entity resolution, source review, and official fact verification.",
      "toolPackage": "plugins/travel-agent/skills/research-trip",
      "securityRequirements": ["source_attribution", "provider_failures_visible", "no_model_fabricated_facts"]
    },
    {
      "capabilityId": "amap_official",
      "description": "Official China POI, routing, weather, and navigation handoff.",
      "toolPackage": "official-provider-adapter",
      "securityRequirements": ["credential_server_side", "live_smoke_required", "read_only"]
    },
    {
      "capabilityId": "transport_query",
      "description": "Read-only rail and flight inventory lookup. No purchase action.",
      "toolPackage": "official-provider-adapter",
      "securityRequirements": ["isolated_read_only_smoke_required", "freshness_visible", "no_purchase"]
    },
    {
      "capabilityId": "fliggy_flyai_search",
      "description": "Read-only hotel, flight, train, ticket, and POI search with handoff links.",
      "toolPackage": "@fly-ai/flyai-cli@1.0.16",
      "securityRequirements": ["restricted_environment", "credential_server_side", "no_booking"]
    },
    {
      "capabilityId": "tuniu_official_mcp",
      "description": "Official read-only hotel, train, flight, and ticket source.",
      "toolPackage": "fixed-endpoint-mcp-client",
      "securityRequirements": ["fixed_endpoint_allowlist", "credential_server_side", "no_booking"]
    }
  ]
}
