{
  "name": "zhuanshu-travel-agent",
  "version": "0.1.0",
  "description": "Type-safe Pi runtime, contracts, providers, and MCP boundaries for Zhuanshu Travel Agent.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.19.0" },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./pi": { "types": "./dist/pi/index.d.ts", "import": "./dist/pi/index.js" },
    "./contracts": { "types": "./dist/contracts/public.d.ts", "import": "./dist/contracts/public.js" },
    "./providers": { "types": "./dist/providers/index.d.ts", "import": "./dist/providers/index.js" },
    "./mcp": { "types": "./dist/mcp/index.d.ts", "import": "./dist/mcp/index.js" },
    "./package.json": "./package.json"
  },
  "pi": { "extensions": ["./dist/pi/index.js"] },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ./scripts/generate-schemas.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1"
  },
  "dependencies": { "typebox": "1.3.7" },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
